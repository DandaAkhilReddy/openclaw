{
  "gateway": {
    "mode": "local"
  },
  "cron": {
    "enabled": true
  },
  "models": {
    "providers": {
      "azure-openai-responses": {
        "models": [
          {
            "id": "Kimi-K2.5",
            "name": "Kimi K2.5 (Azure)",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 8192,
            "compat": { "supportsStore": false }
          },
          {
            "id": "gpt-5-mini",
            "name": "GPT-5-mini (Azure)",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 391000,
            "maxTokens": 16384,
            "compat": { "supportsStore": false }
          }
        ]
      }
    }
  },
  "tools": {
    "message": {
      "crossContext": {
        "allowAcrossProviders": true,
        "marker": {
          "enabled": false
        }
      }
    },
    "media": {
      "audio": {
        "enabled": true,
        "maxBytes": 20971520,
        "models": [
          {
            "type": "cli",
            "command": "bash",
            "args": ["-c", "curl -sS -X POST 'https://areddy-1384-resource.cognitiveservices.azure.com/openai/deployments/gpt-4o-transcribe/audio/transcriptions?api-version=2024-06-01' -H 'api-key: '\"$AZURE_STT_KEY\" -F 'file=@{{MediaPath}}' -F 'response_format=text'"],
            "timeoutSeconds": 30
          },
          {
            "type": "cli",
            "command": "whisper-cli",
            "args": ["-m", "/home/openclaw/.local/share/whisper-models/ggml-base.bin", "-f", "{{MediaPath}}", "--no-timestamps"],
            "timeoutSeconds": 60
          }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "pairing",
      "allowFrom": ["7750772609"],
      "groupPolicy": "allowlist",
      "groupAllowFrom": ["7750772609"],
      "groups": {
        "*": { "requireMention": true }
      }
    },
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": ["12249999944"],
      "groupPolicy": "allowlist",
      "groupAllowFrom": ["12249999944"],
      "groups": {
        "*": { "requireMention": true }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "azure-openai-responses/Kimi-K2.5",
        "fallbacks": ["anthropic/claude-sonnet-4-5-20250929"]
      },
      "heartbeat": {
        "every": "30m"
      },
      "subagents": {
        "maxConcurrent": 5,
        "model": "azure-openai-responses/Kimi-K2.5",
        "archiveAfterMinutes": 60
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "model": "azure-openai-responses/Kimi-K2.5",
        "tools": { "allow": ["message"] },
        "subagents": {
          "allowAgents": ["researcher", "coder", "summarizer"]
        }
      },
      {
        "id": "researcher",
        "model": "azure-openai-responses/Kimi-K2.5",
        "tools": { "allow": ["web_search", "web_fetch", "read"] },
        "sandbox": { "mode": "all", "scope": "session" },
        "subagents": { "allowAgents": [] }
      },
      {
        "id": "coder",
        "model": "azure-openai-responses/Kimi-K2.5",
        "tools": { "allow": ["exec", "read", "write"] },
        "sandbox": { "mode": "non-main", "scope": "session" },
        "subagents": { "allowAgents": [] }
      },
      {
        "id": "summarizer",
        "model": "azure-openai-responses/Kimi-K2.5",
        "tools": { "allow": ["read"] },
        "sandbox": { "mode": "all", "scope": "session" },
        "subagents": { "allowAgents": [] }
      }
    ]
  }
}
